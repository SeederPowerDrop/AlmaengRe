/* Detailed help for keyboard shortcut settings. */
"settings.hint" = "Coloca el puntero sobre una función o un control para ver más detalles. Los atajos duplicados aparecen en rojo.";
"key.helpFormat" = "Elige la tecla para «%@». Activa ⌃, ⌥, ⇧ o ⌘ a su lado para que también sea necesario pulsar esas teclas modificadoras.";
"modifiers.control" = "Control (⌃): si está activado, mantén Control al pulsar la tecla elegida.";
"modifiers.option" = "Opción (⌥): si está activado, mantén Opción al pulsar la tecla elegida.";
"modifiers.shift" = "Mayúsculas (⇧): si está activado, mantén Mayúsculas al pulsar la tecla elegida.";
"modifiers.command" = "Comando (⌘): si está activado, mantén Comando al pulsar la tecla elegida.";
"conflict.helpFormat" = "%@ también está asignado a otra función. Cambia la tecla o los modificadores para ejecutar la función deseada.";
"available.helpFormat" = "%@ no coincide con ninguna otra función de esta lista.";
"reset.help" = "Restaura todos los atajos de esta lista a sus valores predeterminados. Se conservan los nombres de las etiquetas y las etiquetas de las fotos.";
"action.previousPage.help" = "Ve a la imagen anterior, o a la página anterior si ves varias imágenes a la vez. En la comparación A/B, sigue el ajuste Solo A / Ambos / Solo B y mantiene fijos los paneles bloqueados.";
"action.nextPage.help" = "Ve a la imagen siguiente, o a la página siguiente si ves varias imágenes a la vez. En la comparación A/B, sigue el ajuste Solo A / Ambos / Solo B y mantiene fijos los paneles bloqueados.";
"action.zoomIn.help" = "Aumenta la ampliación de la imagen. En la comparación A/B, afecta al panel activo o a ambos según el ajuste de sincronización del zoom.";
"action.zoomOut.help" = "Reduce la ampliación de la imagen. En la comparación A/B, afecta al panel activo o a ambos según el ajuste de sincronización del zoom.";
"action.fitToWindow.help" = "Ajusta la imagen completa al área de visualización y restablece el zoom y el desplazamiento.";
"action.actualPixels.help" = "Muestra la imagen original a su tamaño real en píxeles (1:1) y restablece el desplazamiento. Las imágenes grandes pueden exceder el área de visualización.";
"action.toggleOverview.help" = "Alterna entre el visor de imágenes grandes y una vista general de miniaturas de fotos.";
"action.toggleFocus.help" = "Oculta las barras de herramientas para centrarte en la imagen. Pulsa de nuevo el atajo o Esc para salir del modo de concentración.";
"action.fewerImages.help" = "Muestra una imagen menos a la vez en el visor normal, hasta un mínimo de una.";
"action.moreImages.help" = "Muestra una imagen más a la vez en el visor normal, hasta un máximo de diez.";
"action.openFolder.help" = "Elige imágenes, carpetas o archivos comprimidos compatibles para abrirlos. En la comparación A/B, se abren en el panel activo.";
"action.exportImage.help" = "Guarda la imagen actual con sus ediciones aplicadas. Elige el nombre y la ubicación del archivo en el diálogo de guardado.";
"action.panPrimaryDrag.help" = "Selecciona el arrastre con el botón izquierdo como método de desplazamiento. Después, arrastra una imagen ampliada con el botón izquierdo del ratón.";
"action.panSpaceDrag.help" = "Selecciona Espacio + arrastre con el botón izquierdo como método de desplazamiento. Después, mantén Espacio y arrastra la imagen ampliada con el botón izquierdo.";
"action.panSecondaryDrag.help" = "Selecciona el arrastre con el botón derecho como método de desplazamiento. Después, arrastra una imagen ampliada con el botón derecho del ratón.";
"action.panMiddleDrag.help" = "Selecciona el arrastre con el botón central como método de desplazamiento. Después, mantén la rueda o el botón central y arrastra la imagen ampliada.";
"action.panTrackpadScroll.help" = "Selecciona el desplazamiento con dos dedos en el trackpad para mover la imagen. Después, con la imagen ampliada, desliza dos dedos en la dirección deseada.";
"action.toggleAntialiasing.help" = "Alterna entre suavizar los bordes de los píxeles ampliados y conservar sus límites originales. No crea detalles ausentes en la imagen original.";
"action.compareSideBySide.help" = "Compara lado a lado la ampliación suavizada y pixelada de la misma imagen. Es una función distinta de la comparación A/B de fotos diferentes.";
"action.compareStacked.help" = "Compara la ampliación suavizada y pixelada de la misma imagen en paneles superior e inferior. Es una función distinta de la comparación A/B de fotos diferentes.";
"action.endMagnificationComparison.help" = "Termina la comparación de métodos de ampliación de la misma imagen y vuelve a la visualización normal. Este atajo no cierra la comparación A/B de fotos.";
"action.toggleSlideshow.help" = "Reproduce o pausa la presentación con el intervalo configurado. La reproducción activa el modo de concentración y ajusta una foto a la vez al área de visualización.";
"action.setWallpaper.help" = "Abre los ajustes de fondo de pantalla para la foto actual. Revisa las pantallas de destino y la colocación antes de aplicar.";
"action.toggleFolderComparison.help" = "Abre la comparación A/B para comparar fotos o carpetas en dos paneles. Pulsa de nuevo para volver a la vista anterior.";
"action.previousFirstFolder.help" = "Pasa solo el panel A a su foto anterior. Si está activada la coincidencia por nombre de archivo, ambos paneles pasan al par anterior.";
"action.nextFirstFolder.help" = "Pasa solo el panel A a su foto siguiente. Si está activada la coincidencia por nombre de archivo, ambos paneles pasan al par siguiente.";
"action.previousSecondFolder.help" = "Pasa solo el panel B a su foto anterior. Si está activada la coincidencia por nombre de archivo, ambos paneles pasan al par anterior.";
"action.nextSecondFolder.help" = "Pasa solo el panel B a su foto siguiente. Si está activada la coincidencia por nombre de archivo, ambos paneles pasan al par siguiente.";
