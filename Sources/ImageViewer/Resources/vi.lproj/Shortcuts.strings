/* Detailed help for keyboard shortcut settings. */
"settings.hint" = "Di chuột lên tên chức năng hoặc nút điều khiển để xem mô tả chi tiết. Phím tắt trùng nhau được hiển thị màu đỏ.";
"key.helpFormat" = "Chọn phím cho “%@”. Bật ⌃, ⌥, ⇧ hoặc ⌘ bên cạnh để yêu cầu nhấn đồng thời các phím bổ trợ đó.";
"modifiers.control" = "Control (⌃): khi bật, giữ Control trong lúc nhấn phím đã chọn.";
"modifiers.option" = "Option (⌥): khi bật, giữ Option trong lúc nhấn phím đã chọn.";
"modifiers.shift" = "Shift (⇧): khi bật, giữ Shift trong lúc nhấn phím đã chọn.";
"modifiers.command" = "Command (⌘): khi bật, giữ Command trong lúc nhấn phím đã chọn.";
"conflict.helpFormat" = "%@ cũng được gán cho một chức năng khác. Hãy đổi phím hoặc tổ hợp phím bổ trợ để chạy đúng chức năng mong muốn.";
"available.helpFormat" = "%@ không trùng với chức năng nào khác trong danh sách này.";
"reset.help" = "Khôi phục mọi phím tắt trong danh sách này về mặc định. Tên thẻ và các thẻ đã gắn cho ảnh vẫn được giữ lại.";
"action.previousPage.help" = "Chuyển đến ảnh trước, hoặc trang trước khi xem nhiều ảnh cùng lúc. Khi so sánh A/B, chuyển theo thiết lập Chỉ A / Cả hai / Chỉ B và giữ nguyên các khung đã khóa.";
"action.nextPage.help" = "Chuyển đến ảnh tiếp theo, hoặc trang tiếp theo khi xem nhiều ảnh cùng lúc. Khi so sánh A/B, chuyển theo thiết lập Chỉ A / Cả hai / Chỉ B và giữ nguyên các khung đã khóa.";
"action.zoomIn.help" = "Tăng độ phóng đại của ảnh. Khi so sánh A/B, áp dụng cho khung đang chọn hoặc cả hai khung tùy theo cài đặt đồng bộ thu phóng.";
"action.zoomOut.help" = "Giảm độ phóng đại của ảnh. Khi so sánh A/B, áp dụng cho khung đang chọn hoặc cả hai khung tùy theo cài đặt đồng bộ thu phóng.";
"action.fitToWindow.help" = "Điều chỉnh để toàn bộ ảnh nằm trong vùng xem và đặt lại mức thu phóng cùng vị trí dịch chuyển.";
"action.actualPixels.help" = "Hiển thị ảnh gốc theo kích thước điểm ảnh thực (1:1) và đặt lại vị trí dịch chuyển. Ảnh lớn có thể vượt ra ngoài vùng xem.";
"action.toggleOverview.help" = "Chuyển đổi giữa trình xem ảnh lớn và chế độ tổng quan các ảnh thu nhỏ.";
"action.toggleFocus.help" = "Ẩn các thanh công cụ để tập trung vào ảnh. Nhấn lại phím tắt hoặc nhấn Esc để thoát chế độ tập trung.";
"action.fewerImages.help" = "Giảm một ảnh trong số ảnh hiển thị đồng thời ở trình xem thông thường, tối thiểu còn một ảnh.";
"action.moreImages.help" = "Tăng một ảnh trong số ảnh hiển thị đồng thời ở trình xem thông thường, tối đa mười ảnh.";
"action.openFolder.help" = "Chọn ảnh, thư mục hoặc tệp nén được hỗ trợ để mở. Khi so sánh A/B, mở vào khung đang chọn.";
"action.exportImage.help" = "Lưu ảnh hiện tại với các chỉnh sửa đã áp dụng. Chọn tên tệp và vị trí trong hộp thoại lưu.";
"action.panPrimaryDrag.help" = "Chọn kéo bằng nút chuột trái làm cách dịch chuyển ảnh. Sau đó kéo ảnh đã phóng to bằng nút chuột trái để xem các vùng khác nhau.";
"action.panSpaceDrag.help" = "Chọn Space + kéo bằng nút chuột trái làm cách dịch chuyển ảnh. Sau đó giữ Space và kéo ảnh đã phóng to bằng nút chuột trái.";
"action.panSecondaryDrag.help" = "Chọn kéo bằng nút chuột phải làm cách dịch chuyển ảnh. Sau đó kéo ảnh đã phóng to bằng nút chuột phải để xem các vùng khác nhau.";
"action.panMiddleDrag.help" = "Chọn kéo bằng nút chuột giữa làm cách dịch chuyển ảnh. Sau đó giữ con lăn hoặc nút chuột giữa và kéo ảnh đã phóng to.";
"action.panTrackpadScroll.help" = "Chọn cuộn bằng hai ngón tay trên trackpad làm cách dịch chuyển ảnh. Sau đó, khi đang phóng to, cuộn bằng hai ngón tay để di chuyển lên, xuống, trái hoặc phải.";
"action.toggleAntialiasing.help" = "Chuyển đổi giữa làm mượt đường biên điểm ảnh khi phóng to và giữ nguyên đường biên gốc. Tính năng này không tạo ra chi tiết không có trong ảnh gốc.";
"action.compareSideBySide.help" = "So sánh cách phóng to làm mượt và giữ nguyên điểm ảnh của cùng một ảnh ở hai bên trái phải. Đây là chức năng riêng với so sánh A/B các ảnh khác nhau.";
"action.compareStacked.help" = "So sánh cách phóng to làm mượt và giữ nguyên điểm ảnh của cùng một ảnh ở hai khung trên dưới. Đây là chức năng riêng với so sánh A/B các ảnh khác nhau.";
"action.endMagnificationComparison.help" = "Kết thúc so sánh cách phóng to của cùng một ảnh và trở về hiển thị thông thường. Phím tắt này không kết thúc so sánh ảnh A/B.";
"action.toggleSlideshow.help" = "Phát hoặc tạm dừng trình chiếu theo khoảng thời gian đã đặt. Khi phát, ứng dụng vào chế độ tập trung và hiển thị từng ảnh vừa với vùng xem.";
"action.setWallpaper.help" = "Mở cài đặt hình nền cho ảnh hiện tại. Kiểm tra màn hình đích và cách bố trí ảnh trước khi áp dụng.";
"action.toggleFolderComparison.help" = "Mở chế độ so sánh A/B để so sánh ảnh hoặc thư mục trong hai khung. Nhấn lại để trở về chế độ xem trước đó.";
"action.previousFirstFolder.help" = "Chỉ chuyển khung A về ảnh trước khi so sánh A/B. Nếu bật ghép theo tên tệp, cả hai khung chuyển về cặp ảnh trước.";
"action.nextFirstFolder.help" = "Chỉ chuyển khung A đến ảnh tiếp theo khi so sánh A/B. Nếu bật ghép theo tên tệp, cả hai khung chuyển đến cặp ảnh tiếp theo.";
"action.previousSecondFolder.help" = "Chỉ chuyển khung B về ảnh trước khi so sánh A/B. Nếu bật ghép theo tên tệp, cả hai khung chuyển về cặp ảnh trước.";
"action.nextSecondFolder.help" = "Chỉ chuyển khung B đến ảnh tiếp theo khi so sánh A/B. Nếu bật ghép theo tên tệp, cả hai khung chuyển đến cặp ảnh tiếp theo.";
