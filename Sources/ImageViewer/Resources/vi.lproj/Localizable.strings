"basicUsage.browse.body" = "Ảnh trước / tiếp theo: %@ / %@. Thay đổi số ảnh trên mỗi màn hình bằng các điều khiển xem. ↑/↓ chọn hàng trong Xem tất cả hoặc trong trang hiện tại của Trình xem nhiều mục, với Phân loại ON hay OFF. Di chuyển dừng ở hàng đầu và hàng cuối. Với Phân loại ON hay OFF, ←/→ chuyển cả trang trong Trình xem hoặc từng mục trong Xem tất cả.";
"basicUsage.browse.pages" = "Trong trình xem, %@ chuyển từng màn hình ảnh.";
"basicUsage.view.title" = "Thu phóng và đổi chế độ xem";
"basicUsage.view.body" = "Phóng to / thu nhỏ: %@ / %@. Vừa cửa sổ: %@. Kích thước thực: %@. Tìm ảnh trong Xem tất cả (%@), hoặc dùng Chế độ tập trung (%@) để tập trung vào ảnh. Di chuyển ảnh chỉ cho phép một khoảng nhỏ ở mép; trục nhỏ hơn khung xem luôn được căn giữa.";
"basicUsage.compare.title" = "So sánh hai danh sách ảnh";
"basicUsage.compare.body" = "Mở A và B trong So sánh ảnh (%@), rồi chọn một bên theo tên hiển thị hoặc Cả hai trong Chuyển ảnh. Khóa sẽ giữ nguyên ảnh, mức thu phóng và vị trí của khung đó; đối tượng chuyển ảnh thay đổi theo trạng thái khóa. Dùng nút nhãn dưới tên mỗi khung để chọn nhiều nhãn độc lập và so sánh các nhóm ảnh khác nhau.";
"basicUsage.tags.title" = "Gắn nhãn ảnh và video";
"basicUsage.tags.body" = "Khi Phân loại ON (⇧⌘M), dùng 1–4 · QWER · ASDF để đổi nhiều nhãn của mục hiện tại. Mỗi nút Nhãn trong Trình xem hoặc Xem tất cả chỉ áp dụng cho ảnh hay video đó. OFF khôi phục phím tắt thông thường. Tên và màu có thể sửa; “Xóa” và “Tải lên” chỉ là nhãn, không thao tác lên tệp. Trong So sánh ảnh, chọn riêng Chỉ A, Chỉ B hoặc Cả hai tại Áp dụng nhãn.";
"basicUsage.map.title" = "Chọn vùng trên bản đồ";
"basicUsage.map.body" = "Chọn tối đa ba vùng để duyệt ảnh có vị trí trong Trình xem hoặc Xem tất cả. Thanh màu xanh cho biết số vùng và số ảnh. Quay lại bản đồ khôi phục vị trí và mức thu phóng cuối; Xóa vùng bản đồ chỉ bỏ bộ lọc vị trí.";
"basicUsage.edit.title" = "Chỉnh sửa và lưu bản sao";
"basicUsage.edit.body" = "Dùng nút thanh trượt để cắt, xoay, lật và chỉnh màu. Xuất (%@) bản sao trước khi đóng ứng dụng. Nút i hiển thị thông tin ảnh và siêu dữ liệu.";
"basicUsage.settings.title" = "Tùy chỉnh theo cách của bạn";
"basicUsage.settings.body" = "Thay đổi cách xem, tải ảnh và phím tắt trong Cài đặt. Các phím có thể tùy chỉnh trong hướng dẫn này phản ánh cài đặt hiện tại. Xem hướng dẫn chi tiết trên GitHub để biết đầy đủ chức năng và cách dùng.";

"basicUsage.compare.names" = "Tên so sánh… đặt tên riêng mà không đổi tên thư mục thật; để trống sẽ dùng tên thư mục, hoặc A/B khi cùng một thư mục.";

