/* Detailed help for keyboard shortcut settings. */
"settings.hint" = "Hover over a function or control for details. Duplicate shortcuts appear in red.";
"key.helpFormat" = "Choose the key for “%@”. Enable ⌃, ⌥, ⇧, or ⌘ beside it to require those modifier keys as well.";
"modifiers.control" = "Control (⌃): when enabled, hold Control while pressing the selected key.";
"modifiers.option" = "Option (⌥): when enabled, hold Option while pressing the selected key.";
"modifiers.shift" = "Shift (⇧): when enabled, hold Shift while pressing the selected key.";
"modifiers.command" = "Command (⌘): when enabled, hold Command while pressing the selected key.";
"conflict.helpFormat" = "%@ is assigned to another function too. Change the key or modifiers so the intended function can run.";
"available.helpFormat" = "%@ does not conflict with another function in this list.";
"reset.help" = "Restore every shortcut in this list to its default. Photo tag names and assigned tags are kept.";
"action.previousPage.help" = "Go to the previous image, or the previous page when viewing several images at once. In A/B comparison, follow the A Only / Both / B Only setting and keep locked panes unchanged.";
"action.nextPage.help" = "Go to the next image, or the next page when viewing several images at once. In A/B comparison, follow the A Only / Both / B Only setting and keep locked panes unchanged.";
"action.zoomIn.help" = "Increase the image's display magnification. In A/B comparison, this affects the active pane or both panes according to the zoom synchronization setting.";
"action.zoomOut.help" = "Decrease the image's display magnification. In A/B comparison, this affects the active pane or both panes according to the zoom synchronization setting.";
"action.fitToWindow.help" = "Fit the entire image inside the viewing area and reset zoom and panning.";
"action.actualPixels.help" = "Display the original image at its actual pixel size (1:1) and reset panning. Large images may extend beyond the viewing area.";
"action.toggleOverview.help" = "Switch between the large image viewer and an overview of photo thumbnails.";
"action.toggleFocus.help" = "Hide the toolbars to focus on the image. Press the shortcut again or press Esc to leave focus mode.";
"action.fewerImages.help" = "Show one fewer image at a time in the regular viewer, down to a minimum of one.";
"action.moreImages.help" = "Show one more image at a time in the regular viewer, up to a maximum of ten.";
"action.openFolder.help" = "Choose images, folders, or supported archives to open. In A/B comparison, open them in the active pane.";
"action.exportImage.help" = "Save the current image with its edits applied. Choose the file name and location in the save dialog.";
"action.panPrimaryDrag.help" = "Select left-button dragging as the panning method. Then drag a zoomed image with the left mouse button to move around it.";
"action.panSpaceDrag.help" = "Select Space + left-button dragging as the panning method. Then hold Space and drag a zoomed image with the left mouse button.";
"action.panSecondaryDrag.help" = "Select right-button dragging as the panning method. Then drag a zoomed image with the right mouse button to move around it.";
"action.panMiddleDrag.help" = "Select middle-button dragging as the panning method. Then hold the wheel or middle mouse button and drag a zoomed image.";
"action.panTrackpadScroll.help" = "Select two-finger trackpad scrolling as the panning method. Then scroll with two fingers while zoomed in to move up, down, left, or right.";
"action.toggleAntialiasing.help" = "Switch between smoothing enlarged pixel edges and showing their original boundaries. This does not create detail absent from the original image.";
"action.compareSideBySide.help" = "Compare smooth and pixelated magnification of the same image side by side. This is separate from A/B comparison of different photos.";
"action.compareStacked.help" = "Compare smooth and pixelated magnification of the same image in top and bottom panes. This is separate from A/B comparison of different photos.";
"action.endMagnificationComparison.help" = "End the magnification comparison of the same image and return to normal rendering. This shortcut does not end A/B photo comparison.";
"action.toggleSlideshow.help" = "Play or pause the slideshow at the configured interval. Playback enters focus mode and fits one photo at a time to the viewing area.";
"action.setWallpaper.help" = "Open wallpaper settings for the current photo. Review the target screens and image placement before applying.";
"action.toggleFolderComparison.help" = "Open A/B comparison to compare photos or folders in two panes. Press again to return to the previous view.";
"action.previousFirstFolder.help" = "Move only pane A to its previous photo in A/B comparison. With filename matching enabled, both panes move to the previous matched pair.";
"action.nextFirstFolder.help" = "Move only pane A to its next photo in A/B comparison. With filename matching enabled, both panes move to the next matched pair.";
"action.previousSecondFolder.help" = "Move only pane B to its previous photo in A/B comparison. With filename matching enabled, both panes move to the previous matched pair.";
"action.nextSecondFolder.help" = "Move only pane B to its next photo in A/B comparison. With filename matching enabled, both panes move to the next matched pair.";
