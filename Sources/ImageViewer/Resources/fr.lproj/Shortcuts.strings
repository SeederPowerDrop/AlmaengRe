/* Detailed help for keyboard shortcut settings. */
"settings.hint" = "Survolez une fonction ou une commande pour en savoir plus. Les raccourcis en double apparaissent en rouge.";
"key.helpFormat" = "Choisissez la touche pour « %@ ». Activez les boutons ⌃, ⌥, ⇧ ou ⌘ à côté pour exiger aussi ces touches de modification.";
"modifiers.control" = "Contrôle (⌃) : si activé, maintenez Contrôle en appuyant sur la touche choisie.";
"modifiers.option" = "Option (⌥) : si activé, maintenez Option en appuyant sur la touche choisie.";
"modifiers.shift" = "Majuscule (⇧) : si activé, maintenez Majuscule en appuyant sur la touche choisie.";
"modifiers.command" = "Commande (⌘) : si activé, maintenez Commande en appuyant sur la touche choisie.";
"conflict.helpFormat" = "%@ est aussi attribué à une autre fonction. Changez la touche ou les touches de modification pour exécuter la fonction souhaitée.";
"available.helpFormat" = "%@ ne correspond à aucune autre fonction de cette liste.";
"reset.help" = "Rétablissez tous les raccourcis de cette liste par défaut. Les noms des étiquettes et les étiquettes des photos sont conservés.";
"action.previousPage.help" = "Affichez l’image précédente, ou la page précédente si plusieurs images sont affichées. En comparaison A/B, suivez le réglage A seul / Les deux / B seul ; les volets verrouillés restent inchangés.";
"action.nextPage.help" = "Affichez l’image suivante, ou la page suivante si plusieurs images sont affichées. En comparaison A/B, suivez le réglage A seul / Les deux / B seul ; les volets verrouillés restent inchangés.";
"action.zoomIn.help" = "Augmentez le grossissement de l’image. En comparaison A/B, le volet actif ou les deux volets sont concernés selon le réglage de synchronisation du zoom.";
"action.zoomOut.help" = "Réduisez le grossissement de l’image. En comparaison A/B, le volet actif ou les deux volets sont concernés selon le réglage de synchronisation du zoom.";
"action.fitToWindow.help" = "Ajustez l’image entière à la zone d’affichage et réinitialisez le zoom et le déplacement.";
"action.actualPixels.help" = "Affichez l’image à sa taille réelle en pixels (1:1) et réinitialisez le déplacement. Les grandes images peuvent dépasser la zone d’affichage.";
"action.toggleOverview.help" = "Basculez entre la visionneuse en grand format et la vue d’ensemble des vignettes.";
"action.toggleFocus.help" = "Masquez les barres d’outils pour vous concentrer sur l’image. Réutilisez le raccourci ou appuyez sur Échap pour quitter ce mode.";
"action.fewerImages.help" = "Affichez une image de moins à la fois dans la visionneuse normale, jusqu’à un minimum d’une image.";
"action.moreImages.help" = "Affichez une image de plus à la fois dans la visionneuse normale, jusqu’à un maximum de dix images.";
"action.openFolder.help" = "Choisissez des images, des dossiers ou des archives compatibles à ouvrir. En comparaison A/B, ils s’ouvrent dans le volet actif.";
"action.exportImage.help" = "Enregistrez l’image actuelle avec ses modifications. Choisissez le nom du fichier et son emplacement dans la fenêtre d’enregistrement.";
"action.panPrimaryDrag.help" = "Choisissez le glissement avec le bouton gauche pour déplacer l’image. Faites ensuite glisser une image agrandie avec le bouton gauche de la souris.";
"action.panSpaceDrag.help" = "Choisissez Espace + glissement avec le bouton gauche pour déplacer l’image. Maintenez ensuite Espace et faites glisser une image agrandie avec le bouton gauche.";
"action.panSecondaryDrag.help" = "Choisissez le glissement avec le bouton droit pour déplacer l’image. Faites ensuite glisser une image agrandie avec le bouton droit de la souris.";
"action.panMiddleDrag.help" = "Choisissez le glissement avec le bouton central pour déplacer l’image. Maintenez ensuite la molette ou le bouton central et faites glisser une image agrandie.";
"action.panTrackpadScroll.help" = "Choisissez le défilement à deux doigts sur le trackpad pour déplacer l’image. Une fois l’image agrandie, faites défiler à deux doigts dans la direction souhaitée.";
"action.toggleAntialiasing.help" = "Basculez entre le lissage des pixels agrandis et l’affichage de leurs contours d’origine. Cela ne crée pas de détails absents de l’image originale.";
"action.compareSideBySide.help" = "Comparez côte à côte l’agrandissement lissé et pixelisé de la même image. Cette fonction est distincte de la comparaison A/B de photos différentes.";
"action.compareStacked.help" = "Comparez l’agrandissement lissé et pixelisé de la même image dans deux volets superposés. Cette fonction est distincte de la comparaison A/B de photos différentes.";
"action.endMagnificationComparison.help" = "Terminez la comparaison des méthodes d’agrandissement de la même image et retrouvez l’affichage normal. Ce raccourci ne ferme pas la comparaison A/B de photos.";
"action.toggleSlideshow.help" = "Lancez ou mettez en pause le diaporama à l’intervalle défini. La lecture active le mode concentration et ajuste une photo à la fois à la zone d’affichage.";
"action.setWallpaper.help" = "Ouvrez les réglages du fond d’écran pour la photo actuelle. Vérifiez les écrans cibles et le placement avant d’appliquer.";
"action.toggleFolderComparison.help" = "Ouvrez la comparaison A/B pour comparer des photos ou des dossiers dans deux volets. Réutilisez le raccourci pour revenir à la vue précédente.";
"action.previousFirstFolder.help" = "Passez uniquement le volet A à sa photo précédente. Si la correspondance par nom de fichier est activée, les deux volets passent à la paire précédente.";
"action.nextFirstFolder.help" = "Passez uniquement le volet A à sa photo suivante. Si la correspondance par nom de fichier est activée, les deux volets passent à la paire suivante.";
"action.previousSecondFolder.help" = "Passez uniquement le volet B à sa photo précédente. Si la correspondance par nom de fichier est activée, les deux volets passent à la paire précédente.";
"action.nextSecondFolder.help" = "Passez uniquement le volet B à sa photo suivante. Si la correspondance par nom de fichier est activée, les deux volets passent à la paire suivante.";
