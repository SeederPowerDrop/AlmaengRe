/* Detailed help for keyboard shortcut settings. */
"settings.hint" = "Наведите указатель на функцию или элемент управления для подробностей. Повторяющиеся сочетания выделены красным.";
"key.helpFormat" = "Выберите клавишу для «%@». Включите ⌃, ⌥, ⇧ или ⌘ рядом с ней, чтобы также требовались эти модификаторы.";
"modifiers.control" = "Control (⌃): если включено, удерживайте Control при нажатии выбранной клавиши.";
"modifiers.option" = "Option (⌥): если включено, удерживайте Option при нажатии выбранной клавиши.";
"modifiers.shift" = "Shift (⇧): если включено, удерживайте Shift при нажатии выбранной клавиши.";
"modifiers.command" = "Command (⌘): если включено, удерживайте Command при нажатии выбранной клавиши.";
"conflict.helpFormat" = "%@ назначено и другой функции. Измените клавишу или модификаторы для выполнения нужной функции.";
"available.helpFormat" = "%@ не конфликтует с другими функциями в этом списке.";
"reset.help" = "Восстановить все сочетания клавиш в списке по умолчанию. Имена меток и применённые метки фотографий сохраняются.";
"action.previousPage.help" = "Перейти к предыдущему изображению или предыдущей странице при просмотре нескольких изображений. При сравнении A/B учитывается настройка «Только A / Обе / Только B»; закреплённые панели не меняются.";
"action.nextPage.help" = "Перейти к следующему изображению или следующей странице при просмотре нескольких изображений. При сравнении A/B учитывается настройка «Только A / Обе / Только B»; закреплённые панели не меняются.";
"action.zoomIn.help" = "Увеличить масштаб отображения изображения. При сравнении A/B меняется активная панель или обе, в зависимости от настройки синхронизации масштаба.";
"action.zoomOut.help" = "Уменьшить масштаб отображения изображения. При сравнении A/B меняется активная панель или обе, в зависимости от настройки синхронизации масштаба.";
"action.fitToWindow.help" = "Вписать всё изображение в область просмотра и сбросить масштаб и перемещение.";
"action.actualPixels.help" = "Показать оригинал в реальном размере пикселей (1:1) и сбросить перемещение. Большие изображения могут выходить за пределы области просмотра.";
"action.toggleOverview.help" = "Переключиться между крупным просмотром изображения и обзором миниатюр фотографий.";
"action.toggleFocus.help" = "Скрыть панели инструментов, чтобы сосредоточиться на изображении. Нажмите сочетание ещё раз или Esc для выхода из режима концентрации.";
"action.fewerImages.help" = "Уменьшить число одновременно отображаемых изображений в обычном просмотре на одно, минимум до одного.";
"action.moreImages.help" = "Увеличить число одновременно отображаемых изображений в обычном просмотре на одно, максимум до десяти.";
"action.openFolder.help" = "Выбрать изображения, папки или поддерживаемые архивы для открытия. При сравнении A/B они открываются в активной панели.";
"action.exportImage.help" = "Сохранить текущее изображение с применёнными правками. Выберите имя файла и расположение в диалоге сохранения.";
"action.panPrimaryDrag.help" = "Выбрать перемещение левой кнопкой. Затем перетягивайте увеличенное изображение левой кнопкой мыши.";
"action.panSpaceDrag.help" = "Выбрать перемещение Space + левой кнопкой. Затем удерживайте Space и перетягивайте увеличенное изображение левой кнопкой мыши.";
"action.panSecondaryDrag.help" = "Выбрать перемещение правой кнопкой. Затем перетягивайте увеличенное изображение правой кнопкой мыши.";
"action.panMiddleDrag.help" = "Выбрать перемещение средней кнопкой. Затем удерживайте колёсико или среднюю кнопку мыши и перетягивайте увеличенное изображение.";
"action.panTrackpadScroll.help" = "Выбрать перемещение прокруткой двумя пальцами на трекпаде. При увеличении прокручивайте двумя пальцами для перемещения вверх, вниз, влево или вправо.";
"action.toggleAntialiasing.help" = "Переключиться между сглаживанием увеличенных границ пикселей и показом их исходных границ. Детали, отсутствующие в оригинале, не создаются.";
"action.compareSideBySide.help" = "Сравнить сглаженное и пиксельное увеличение одного изображения по горизонтали. Это отдельный режим, не связанный со сравнением разных фото A/B.";
"action.compareStacked.help" = "Сравнить сглаженное и пиксельное увеличение одного изображения в верхней и нижней панелях. Это отдельный режим, не связанный со сравнением разных фото A/B.";
"action.endMagnificationComparison.help" = "Завершить сравнение увеличения одного изображения и вернуться к обычному отображению. Это сочетание не завершает сравнение фотографий A/B.";
"action.toggleSlideshow.help" = "Воспроизвести или приостановить слайд-шоу с заданным интервалом. Воспроизведение включает режим концентрации и вписывает в область просмотра по одному фото.";
"action.setWallpaper.help" = "Открыть настройки обоев для текущего фото. Проверьте целевые экраны и размещение изображения перед применением.";
"action.toggleFolderComparison.help" = "Открыть сравнение A/B для сравнения фотографий или папок в двух панелях. Повторное нажатие вернёт предыдущий вид.";
"action.previousFirstFolder.help" = "Перейти к предыдущему фото только в панели A при сравнении A/B. При сопоставлении по именам файлов обе панели переходят к предыдущей паре.";
"action.nextFirstFolder.help" = "Перейти к следующему фото только в панели A при сравнении A/B. При сопоставлении по именам файлов обе панели переходят к следующей паре.";
"action.previousSecondFolder.help" = "Перейти к предыдущему фото только в панели B при сравнении A/B. При сопоставлении по именам файлов обе панели переходят к предыдущей паре.";
"action.nextSecondFolder.help" = "Перейти к следующему фото только в панели B при сравнении A/B. При сопоставлении по именам файлов обе панели переходят к следующей паре.";
