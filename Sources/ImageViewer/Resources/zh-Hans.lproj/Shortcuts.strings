/* Detailed help for keyboard shortcut settings. */
"settings.hint" = "将指针悬停在功能或控件上可查看详细说明。重复的快捷键会显示为红色。";
"key.helpFormat" = "选择“%@”使用的按键。启用旁边的 ⌃、⌥、⇧ 或 ⌘ 后，使用时也需要同时按住相应的修饰键。";
"modifiers.control" = "Control (⌃)：启用后，按所选按键时需要同时按住 Control。";
"modifiers.option" = "Option (⌥)：启用后，按所选按键时需要同时按住 Option。";
"modifiers.shift" = "Shift (⇧)：启用后，按所选按键时需要同时按住 Shift。";
"modifiers.command" = "Command (⌘)：启用后，按所选按键时需要同时按住 Command。";
"conflict.helpFormat" = "%@ 也被分配给了其他功能。请更改按键或修饰键，以便执行预期的功能。";
"available.helpFormat" = "%@ 与此列表中的其他功能没有冲突。";
"reset.help" = "将此列表中的所有快捷键恢复为默认设置。照片的标签名称和已添加的标签会保留。";
"action.previousPage.help" = "转到上一张图片；同时查看多张图片时，转到上一页。在 A/B 比较中，按仅 A / 两侧 / 仅 B 设置切换，锁定的一侧保持不变。";
"action.nextPage.help" = "转到下一张图片；同时查看多张图片时，转到下一页。在 A/B 比较中，按仅 A / 两侧 / 仅 B 设置切换，锁定的一侧保持不变。";
"action.zoomIn.help" = "提高图片的显示倍率。在 A/B 比较中，根据缩放同步设置，应用于当前侧或两侧。";
"action.zoomOut.help" = "降低图片的显示倍率。在 A/B 比较中，根据缩放同步设置，应用于当前侧或两侧。";
"action.fitToWindow.help" = "将整张图片缩放至显示区域内，并重置缩放倍率和平移位置。";
"action.actualPixels.help" = "按原图的实际像素大小（1:1）显示，并重置平移位置。较大的图片可能超出显示区域。";
"action.toggleOverview.help" = "在大图查看器和照片缩略图总览之间切换。";
"action.toggleFocus.help" = "隐藏工具栏以专注查看图片。再次按下快捷键或按 Esc 可退出专注模式。";
"action.fewerImages.help" = "在普通查看器中，将同时显示的图片数量减少一张，最少为一张。";
"action.moreImages.help" = "在普通查看器中，将同时显示的图片数量增加一张，最多为十张。";
"action.openFolder.help" = "选择并打开图片、文件夹或支持的压缩文件。在 A/B 比较中，打开到当前选中的一侧。";
"action.exportImage.help" = "保存应用了编辑效果的当前图片。在保存对话框中选择文件名和位置。";
"action.panPrimaryDrag.help" = "将图片平移方式设为鼠标左键拖动。然后按住左键拖动放大的图片，查看不同区域。";
"action.panSpaceDrag.help" = "将图片平移方式设为 Space＋鼠标左键拖动。然后按住 Space，用左键拖动放大的图片。";
"action.panSecondaryDrag.help" = "将图片平移方式设为鼠标右键拖动。然后按住右键拖动放大的图片，查看不同区域。";
"action.panMiddleDrag.help" = "将图片平移方式设为鼠标中键拖动。然后按住滚轮或中键，拖动放大的图片。";
"action.panTrackpadScroll.help" = "将图片平移方式设为触控板双指滚动。然后在放大时用双指滚动，即可向上下左右移动。";
"action.toggleAntialiasing.help" = "切换放大时平滑显示像素边缘或保留原始像素边界。此功能不会生成原图中不存在的细节。";
"action.compareSideBySide.help" = "将同一张图片的平滑放大效果和保留像素边界的效果左右并排比较。此功能与比较不同照片的 A/B 比较不同。";
"action.compareStacked.help" = "将同一张图片的平滑放大效果和保留像素边界的效果上下排列比较。此功能与比较不同照片的 A/B 比较不同。";
"action.endMagnificationComparison.help" = "结束同一张图片的放大方式比较，返回普通显示。此快捷键不会结束 A/B 照片比较。";
"action.toggleSlideshow.help" = "按设定的间隔播放或暂停照片幻灯片。播放时进入专注模式，每次将一张照片适配到显示区域。";
"action.setWallpaper.help" = "打开当前照片的壁纸设置。确认目标屏幕和图片布局后即可应用。";
"action.toggleFolderComparison.help" = "切换到 A/B 比较，在两侧打开照片或文件夹进行比较。再次按下可返回之前的视图。";
"action.previousFirstFolder.help" = "在 A/B 比较中，仅将 A 侧切换到上一张照片。启用文件名匹配时，两侧会一起转到上一对匹配照片。";
"action.nextFirstFolder.help" = "在 A/B 比较中，仅将 A 侧切换到下一张照片。启用文件名匹配时，两侧会一起转到下一对匹配照片。";
"action.previousSecondFolder.help" = "在 A/B 比较中，仅将 B 侧切换到上一张照片。启用文件名匹配时，两侧会一起转到上一对匹配照片。";
"action.nextSecondFolder.help" = "在 A/B 比较中，仅将 B 侧切换到下一张照片。启用文件名匹配时，两侧会一起转到下一对匹配照片。";
