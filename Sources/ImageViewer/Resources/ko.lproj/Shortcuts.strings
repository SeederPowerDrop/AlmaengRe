/* Detailed help for keyboard shortcut settings. */
"settings.hint" = "기능 이름과 버튼에 마우스를 올리면 자세한 설명이 표시됩니다. 같은 단축키가 겹치면 빨간색으로 표시됩니다.";
"key.helpFormat" = "‘%@’에 사용할 키를 선택합니다. 옆의 ⌃, ⌥, ⇧, ⌘ 버튼을 켜면 해당 키도 함께 눌러야 합니다.";
"modifiers.control" = "Control (⌃): 켜면 선택한 키와 Control 키를 함께 눌러야 합니다.";
"modifiers.option" = "Option (⌥): 켜면 선택한 키와 Option 키를 함께 눌러야 합니다.";
"modifiers.shift" = "Shift (⇧): 켜면 선택한 키와 Shift 키를 함께 눌러야 합니다.";
"modifiers.command" = "Command (⌘): 켜면 선택한 키와 Command 키를 함께 눌러야 합니다.";
"conflict.helpFormat" = "%@ 단축키가 다른 기능과 겹칩니다. 원하는 기능이 실행되도록 키나 보조 키 조합을 바꿔 주세요.";
"available.helpFormat" = "%@ 단축키는 이 목록의 다른 기능과 겹치지 않습니다.";
"reset.help" = "이 목록의 모든 단축키를 기본 설정으로 되돌립니다. 사진의 분류 이름과 표시는 그대로 유지됩니다.";
"action.previousPage.help" = "이전 이미지로 이동합니다. 한 화면에 여러 이미지를 보고 있다면 이전 페이지로 이동합니다. 이미지 비교 중에는 A만 / 양쪽 / B만 설정에 따라 넘기며, 잠긴 쪽은 그대로 유지합니다.";
"action.nextPage.help" = "다음 이미지로 이동합니다. 한 화면에 여러 이미지를 보고 있다면 다음 페이지로 이동합니다. 이미지 비교 중에는 A만 / 양쪽 / B만 설정에 따라 넘기며, 잠긴 쪽은 그대로 유지합니다.";
"action.zoomIn.help" = "현재 이미지의 표시 배율을 높입니다. 이미지 비교 중에는 확대 동기화 설정에 따라 선택한 칸 또는 양쪽에 적용됩니다.";
"action.zoomOut.help" = "현재 이미지의 표시 배율을 낮춥니다. 이미지 비교 중에는 확대 동기화 설정에 따라 선택한 칸 또는 양쪽에 적용됩니다.";
"action.fitToWindow.help" = "이미지 전체가 화면 안에 들어오도록 맞추고, 확대 배율과 이동 위치를 초기화합니다.";
"action.actualPixels.help" = "원본 이미지의 실제 픽셀 크기(1:1)로 표시하고 이동 위치를 초기화합니다. 큰 이미지는 화면 일부를 벗어날 수 있습니다.";
"action.toggleOverview.help" = "이미지를 크게 보는 뷰어와 여러 사진의 썸네일을 모아 보는 몽땅보기 사이를 전환합니다.";
"action.toggleFocus.help" = "도구 모음을 숨기고 이미지에 집중하는 보기로 전환합니다. 다시 누르거나 Esc를 누르면 집중 모드에서 나옵니다.";
"action.fewerImages.help" = "일반 뷰어에서 한 화면에 함께 표시할 이미지 수를 하나 줄입니다. 최소 1장까지 줄일 수 있습니다.";
"action.moreImages.help" = "일반 뷰어에서 한 화면에 함께 표시할 이미지 수를 하나 늘립니다. 최대 10장까지 볼 수 있습니다.";
"action.openFolder.help" = "이미지, 폴더 또는 지원하는 압축 파일을 선택해 엽니다. 이미지 비교 중에는 현재 선택한 A/B 칸에 엽니다.";
"action.exportImage.help" = "현재 이미지에 적용한 편집을 반영해 파일로 저장합니다. 저장 창에서 파일 이름과 위치를 정할 수 있습니다.";
"action.panPrimaryDrag.help" = "이미지 이동 방식을 ‘왼쪽 버튼 드래그’로 선택합니다. 선택한 뒤 확대된 이미지를 왼쪽 버튼으로 잡아 끌어 이동합니다.";
"action.panSpaceDrag.help" = "이미지 이동 방식을 ‘Space + 왼쪽 드래그’로 선택합니다. 선택한 뒤 Space를 누른 채 왼쪽 버튼으로 확대된 이미지를 끌어 이동합니다.";
"action.panSecondaryDrag.help" = "이미지 이동 방식을 ‘오른쪽 버튼 드래그’로 선택합니다. 선택한 뒤 오른쪽 버튼을 누른 채 확대된 이미지를 끌어 이동합니다.";
"action.panMiddleDrag.help" = "이미지 이동 방식을 ‘가운데 버튼 드래그’로 선택합니다. 선택한 뒤 휠 또는 가운데 버튼을 누른 채 확대된 이미지를 끌어 이동합니다.";
"action.panTrackpadScroll.help" = "이미지 이동 방식을 ‘트랙패드 두 손가락 이동’으로 선택합니다. 선택한 뒤 확대 상태에서 두 손가락으로 스크롤해 상하좌우를 살펴봅니다.";
"action.toggleAntialiasing.help" = "확대할 때 픽셀 경계를 부드럽게 표시할지, 원본 픽셀 경계를 그대로 표시할지 전환합니다. 원본에 없는 세부 정보를 새로 만드는 기능은 아닙니다.";
"action.compareSideBySide.help" = "같은 이미지의 고화질 확대와 픽셀 그대로 보기를 좌우에 나란히 표시해 비교합니다. 서로 다른 A/B 사진을 여는 이미지 비교와는 별도 기능입니다.";
"action.compareStacked.help" = "같은 이미지의 고화질 확대와 픽셀 그대로 보기를 위아래로 표시해 비교합니다. 서로 다른 A/B 사진을 여는 이미지 비교와는 별도 기능입니다.";
"action.endMagnificationComparison.help" = "같은 이미지의 확대 방식 비교를 끝내고 일반 표시로 돌아갑니다. A/B 이미지 비교를 종료하는 단축키는 아닙니다.";
"action.toggleSlideshow.help" = "설정한 간격으로 사진을 자동으로 넘기는 전자 앨범을 재생하거나 일시정지합니다. 재생하면 집중 모드에서 사진 한 장씩 화면에 맞춰 표시합니다.";
"action.setWallpaper.help" = "현재 사진으로 바탕화면을 설정하는 창을 엽니다. 적용할 화면과 배치 방식을 확인한 뒤 설정할 수 있습니다.";
"action.toggleFolderComparison.help" = "A/B 두 칸에 사진이나 폴더를 열어 비교하는 화면으로 전환합니다. 다시 누르면 비교 전의 보기로 돌아갑니다.";
"action.previousFirstFolder.help" = "이미지 비교에서 A 칸만 이전 사진으로 넘깁니다. 파일명 맞춤을 사용 중이면 대응 관계를 유지하며 A/B가 함께 이전 쌍으로 이동합니다.";
"action.nextFirstFolder.help" = "이미지 비교에서 A 칸만 다음 사진으로 넘깁니다. 파일명 맞춤을 사용 중이면 대응 관계를 유지하며 A/B가 함께 다음 쌍으로 이동합니다.";
"action.previousSecondFolder.help" = "이미지 비교에서 B 칸만 이전 사진으로 넘깁니다. 파일명 맞춤을 사용 중이면 대응 관계를 유지하며 A/B가 함께 이전 쌍으로 이동합니다.";
"action.nextSecondFolder.help" = "이미지 비교에서 B 칸만 다음 사진으로 넘깁니다. 파일명 맞춤을 사용 중이면 대응 관계를 유지하며 A/B가 함께 다음 쌍으로 이동합니다.";
