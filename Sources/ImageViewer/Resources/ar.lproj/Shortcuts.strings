/* Detailed help for keyboard shortcut settings. */
"settings.hint" = "مرّر المؤشر فوق اسم الوظيفة أو عنصر التحكم لعرض شرح مفصل. تظهر الاختصارات المكررة باللون الأحمر.";
"key.helpFormat" = "اختر المفتاح لوظيفة «%@». فعّل ⌃ أو ⌥ أو ⇧ أو ⌘ بجانبه لطلب الضغط على مفاتيح التعديل هذه أيضًا.";
"modifiers.control" = "Control (⌃): عند التفعيل، اضغط مطولًا على Control أثناء الضغط على المفتاح المحدد.";
"modifiers.option" = "Option (⌥): عند التفعيل، اضغط مطولًا على Option أثناء الضغط على المفتاح المحدد.";
"modifiers.shift" = "Shift (⇧): عند التفعيل، اضغط مطولًا على Shift أثناء الضغط على المفتاح المحدد.";
"modifiers.command" = "Command (⌘): عند التفعيل، اضغط مطولًا على Command أثناء الضغط على المفتاح المحدد.";
"conflict.helpFormat" = "الاختصار %@ معيّن لوظيفة أخرى أيضًا. غيّر المفتاح أو مفاتيح التعديل لتشغيل الوظيفة المطلوبة.";
"available.helpFormat" = "لا يتعارض الاختصار %@ مع وظيفة أخرى في هذه القائمة.";
"reset.help" = "أعد جميع اختصارات هذه القائمة إلى الإعدادات الافتراضية. تُحفظ أسماء الوسوم والوسوم المضافة إلى الصور.";
"action.previousPage.help" = "انتقل إلى الصورة السابقة، أو إلى الصفحة السابقة عند عرض عدة صور معًا. في مقارنة A/B، اتبع إعداد A فقط / كلاهما / B فقط، مع إبقاء اللوحات المقفلة دون تغيير.";
"action.nextPage.help" = "انتقل إلى الصورة التالية، أو إلى الصفحة التالية عند عرض عدة صور معًا. في مقارنة A/B، اتبع إعداد A فقط / كلاهما / B فقط، مع إبقاء اللوحات المقفلة دون تغيير.";
"action.zoomIn.help" = "زِد تكبير عرض الصورة. في مقارنة A/B، يُطبّق على اللوحة النشطة أو اللوحتين وفق إعداد مزامنة التكبير.";
"action.zoomOut.help" = "قلّل تكبير عرض الصورة. في مقارنة A/B، يُطبّق على اللوحة النشطة أو اللوحتين وفق إعداد مزامنة التكبير.";
"action.fitToWindow.help" = "لائم الصورة بأكملها داخل منطقة العرض وأعد ضبط التكبير وموضع التحريك.";
"action.actualPixels.help" = "اعرض الصورة الأصلية بحجم البكسل الفعلي (1:1) وأعد ضبط موضع التحريك. قد تتجاوز الصور الكبيرة منطقة العرض.";
"action.toggleOverview.help" = "بدّل بين عارض الصور بحجم كبير والعرض الشامل لمصغرات الصور.";
"action.toggleFocus.help" = "أخفِ أشرطة الأدوات للتركيز على الصورة. اضغط الاختصار مجددًا أو اضغط Esc للخروج من وضع التركيز.";
"action.fewerImages.help" = "قلّل عدد الصور المعروضة معًا في العارض العادي بمقدار صورة واحدة، حتى حد أدنى قدره صورة واحدة.";
"action.moreImages.help" = "زِد عدد الصور المعروضة معًا في العارض العادي بمقدار صورة واحدة، حتى عشر صور كحد أقصى.";
"action.openFolder.help" = "اختر الصور أو المجلدات أو الأرشيفات المدعومة لفتحها. في مقارنة A/B، تُفتح في اللوحة النشطة.";
"action.exportImage.help" = "احفظ الصورة الحالية مع تطبيق تعديلاتها. اختر اسم الملف وموقعه في نافذة الحفظ.";
"action.panPrimaryDrag.help" = "اختر السحب بزر الفأرة الأيسر كطريقة لتحريك الصورة. ثم اسحب الصورة المكبّرة بالزر الأيسر لاستعراض أجزائها.";
"action.panSpaceDrag.help" = "اختر Space مع السحب بالزر الأيسر كطريقة لتحريك الصورة. ثم اضغط مطولًا على Space واسحب الصورة المكبّرة بزر الفأرة الأيسر.";
"action.panSecondaryDrag.help" = "اختر السحب بزر الفأرة الأيمن كطريقة لتحريك الصورة. ثم اسحب الصورة المكبّرة بالزر الأيمن لاستعراض أجزائها.";
"action.panMiddleDrag.help" = "اختر السحب بزر الفأرة الأوسط كطريقة لتحريك الصورة. ثم اضغط مطولًا على العجلة أو الزر الأوسط واسحب الصورة المكبّرة.";
"action.panTrackpadScroll.help" = "اختر التمرير بإصبعين على لوحة التعقب كطريقة لتحريك الصورة. ثم مرّر بإصبعين أثناء التكبير للتحرك لأعلى أو لأسفل أو لليسار أو لليمين.";
"action.toggleAntialiasing.help" = "بدّل بين تنعيم حواف البكسلات المكبّرة وعرض حدودها الأصلية. لا تضيف هذه الوظيفة تفاصيل غير موجودة في الصورة الأصلية.";
"action.compareSideBySide.help" = "قارن التكبير الناعم والتكبير مع إبقاء حدود البكسلات للصورة نفسها جنبًا إلى جنب. هذه وظيفة منفصلة عن مقارنة A/B لصور مختلفة.";
"action.compareStacked.help" = "قارن التكبير الناعم والتكبير مع إبقاء حدود البكسلات للصورة نفسها في لوحتين علوية وسفلية. هذه وظيفة منفصلة عن مقارنة A/B لصور مختلفة.";
"action.endMagnificationComparison.help" = "أنهِ مقارنة طرق تكبير الصورة نفسها وعُد إلى العرض العادي. لا ينهي هذا الاختصار مقارنة الصور A/B.";
"action.toggleSlideshow.help" = "شغّل عرض الشرائح أو أوقفه مؤقتًا وفق الفاصل المحدد. يبدأ التشغيل في وضع التركيز ويعرض صورة واحدة كل مرة بحجم يلائم منطقة العرض.";
"action.setWallpaper.help" = "افتح إعدادات خلفية سطح المكتب للصورة الحالية. راجع الشاشات المستهدفة وطريقة وضع الصورة قبل التطبيق.";
"action.toggleFolderComparison.help" = "افتح مقارنة A/B لمقارنة الصور أو المجلدات في لوحتين. اضغط مجددًا للعودة إلى العرض السابق.";
"action.previousFirstFolder.help" = "انتقل باللوحة A فقط إلى صورتها السابقة في مقارنة A/B. عند تفعيل المطابقة حسب اسم الملف، تنتقل اللوحتان إلى الزوج السابق.";
"action.nextFirstFolder.help" = "انتقل باللوحة A فقط إلى صورتها التالية في مقارنة A/B. عند تفعيل المطابقة حسب اسم الملف، تنتقل اللوحتان إلى الزوج التالي.";
"action.previousSecondFolder.help" = "انتقل باللوحة B فقط إلى صورتها السابقة في مقارنة A/B. عند تفعيل المطابقة حسب اسم الملف، تنتقل اللوحتان إلى الزوج السابق.";
"action.nextSecondFolder.help" = "انتقل باللوحة B فقط إلى صورتها التالية في مقارنة A/B. عند تفعيل المطابقة حسب اسم الملف، تنتقل اللوحتان إلى الزوج التالي.";
