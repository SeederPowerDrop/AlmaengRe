/* Detailed help for keyboard shortcut settings. */
"settings.hint" = "Bewege den Zeiger über eine Funktion oder ein Steuerelement, um Details zu sehen. Doppelte Kurzbefehle erscheinen rot.";
"key.helpFormat" = "Wähle die Taste für „%@“. Aktiviere daneben ⌃, ⌥, ⇧ oder ⌘, wenn diese Sondertasten zusätzlich gedrückt werden müssen.";
"modifiers.control" = "Control (⌃): Wenn aktiviert, halte Control gedrückt und drücke die gewählte Taste.";
"modifiers.option" = "Option (⌥): Wenn aktiviert, halte Option gedrückt und drücke die gewählte Taste.";
"modifiers.shift" = "Shift (⇧): Wenn aktiviert, halte Shift gedrückt und drücke die gewählte Taste.";
"modifiers.command" = "Command (⌘): Wenn aktiviert, halte Command gedrückt und drücke die gewählte Taste.";
"conflict.helpFormat" = "%@ ist auch einer anderen Funktion zugewiesen. Ändere die Taste oder Sondertasten, damit die gewünschte Funktion ausgeführt werden kann.";
"available.helpFormat" = "%@ steht mit keiner anderen Funktion in dieser Liste in Konflikt.";
"reset.help" = "Setzt alle Kurzbefehle dieser Liste auf ihre Standardwerte zurück. Namen und zugewiesene Fotomarkierungen bleiben erhalten.";
"action.previousPage.help" = "Wechselt zum vorherigen Bild oder bei mehreren gleichzeitig angezeigten Bildern zur vorherigen Seite. Im A/B-Vergleich wird die Einstellung „Nur A“ / „Beide“ / „Nur B“ beachtet; gesperrte Bereiche bleiben unverändert.";
"action.nextPage.help" = "Wechselt zum nächsten Bild oder bei mehreren gleichzeitig angezeigten Bildern zur nächsten Seite. Im A/B-Vergleich wird die Einstellung „Nur A“ / „Beide“ / „Nur B“ beachtet; gesperrte Bereiche bleiben unverändert.";
"action.zoomIn.help" = "Erhöht die Vergrößerung des Bildes. Im A/B-Vergleich wirkt sich dies je nach Einstellung der Zoomsynchronisierung auf den aktiven Bereich oder beide Bereiche aus.";
"action.zoomOut.help" = "Verringert die Vergrößerung des Bildes. Im A/B-Vergleich wirkt sich dies je nach Einstellung der Zoomsynchronisierung auf den aktiven Bereich oder beide Bereiche aus.";
"action.fitToWindow.help" = "Passt das gesamte Bild in den Ansichtsbereich ein und setzt Zoom und Bildausschnitt zurück.";
"action.actualPixels.help" = "Zeigt das Originalbild in tatsächlicher Pixelgröße (1:1) an und setzt den Bildausschnitt zurück. Große Bilder können über den Ansichtsbereich hinausragen.";
"action.toggleOverview.help" = "Wechselt zwischen der großen Bildansicht und einer Übersicht mit Fotominiaturen.";
"action.toggleFocus.help" = "Blendet die Symbolleisten aus, damit das Bild im Mittelpunkt steht. Drücke den Kurzbefehl erneut oder Esc, um den Fokusmodus zu verlassen.";
"action.fewerImages.help" = "Zeigt in der normalen Bildansicht jeweils ein Bild weniger an, mindestens jedoch eines.";
"action.moreImages.help" = "Zeigt in der normalen Bildansicht jeweils ein Bild mehr an, höchstens jedoch zehn.";
"action.openFolder.help" = "Wählt Bilder, Ordner oder unterstützte Archive zum Öffnen aus. Im A/B-Vergleich werden sie im aktiven Bereich geöffnet.";
"action.exportImage.help" = "Sichert das aktuelle Bild mit den angewendeten Änderungen. Wähle Dateiname und Speicherort im Dialog.";
"action.panPrimaryDrag.help" = "Wählt Ziehen mit der linken Maustaste als Verschiebemethode. Ziehe anschließend das vergrößerte Bild mit der linken Maustaste, um den Bildausschnitt zu ändern.";
"action.panSpaceDrag.help" = "Wählt Space + Ziehen mit der linken Maustaste als Verschiebemethode. Halte anschließend Space gedrückt und ziehe das vergrößerte Bild mit der linken Maustaste.";
"action.panSecondaryDrag.help" = "Wählt Ziehen mit der rechten Maustaste als Verschiebemethode. Ziehe anschließend das vergrößerte Bild mit der rechten Maustaste, um den Bildausschnitt zu ändern.";
"action.panMiddleDrag.help" = "Wählt Ziehen mit der mittleren Maustaste als Verschiebemethode. Halte anschließend das Mausrad oder die mittlere Maustaste gedrückt und ziehe das vergrößerte Bild.";
"action.panTrackpadScroll.help" = "Wählt Scrollen mit zwei Fingern auf dem Trackpad als Verschiebemethode. Scrolle anschließend bei vergrößertem Bild mit zwei Fingern nach oben, unten, links oder rechts.";
"action.toggleAntialiasing.help" = "Wechselt zwischen geglätteten vergrößerten Pixelkanten und ihren ursprünglichen Grenzen. Im Originalbild fehlende Details werden nicht erzeugt.";
"action.compareSideBySide.help" = "Vergleicht die geglättete und pixelgenaue Vergrößerung desselben Bildes nebeneinander. Dies ist unabhängig vom A/B-Vergleich unterschiedlicher Fotos.";
"action.compareStacked.help" = "Vergleicht die geglättete und pixelgenaue Vergrößerung desselben Bildes übereinander. Dies ist unabhängig vom A/B-Vergleich unterschiedlicher Fotos.";
"action.endMagnificationComparison.help" = "Beendet den Vergrößerungsvergleich desselben Bildes und kehrt zur normalen Darstellung zurück. Dieser Kurzbefehl beendet den A/B-Fotovergleich nicht.";
"action.toggleSlideshow.help" = "Spielt die Diashow im eingestellten Intervall ab oder pausiert sie. Die Wiedergabe öffnet den Fokusmodus und passt jeweils ein Foto in den Ansichtsbereich ein.";
"action.setWallpaper.help" = "Öffnet die Hintergrundeinstellungen für das aktuelle Foto. Prüfe vor dem Anwenden die Zieldisplays und Bildplatzierung.";
"action.toggleFolderComparison.help" = "Öffnet den A/B-Vergleich, um Fotos oder Ordner in zwei Bereichen zu vergleichen. Erneutes Drücken kehrt zur vorherigen Ansicht zurück.";
"action.previousFirstFolder.help" = "Wechselt im A/B-Vergleich nur in Bereich A zum vorherigen Foto. Bei aktiviertem Dateinamenabgleich wechseln beide Bereiche zum vorherigen passenden Paar.";
"action.nextFirstFolder.help" = "Wechselt im A/B-Vergleich nur in Bereich A zum nächsten Foto. Bei aktiviertem Dateinamenabgleich wechseln beide Bereiche zum nächsten passenden Paar.";
"action.previousSecondFolder.help" = "Wechselt im A/B-Vergleich nur in Bereich B zum vorherigen Foto. Bei aktiviertem Dateinamenabgleich wechseln beide Bereiche zum vorherigen passenden Paar.";
"action.nextSecondFolder.help" = "Wechselt im A/B-Vergleich nur in Bereich B zum nächsten Foto. Bei aktiviertem Dateinamenabgleich wechseln beide Bereiche zum nächsten passenden Paar.";
