/* Detailed help for keyboard shortcut settings. */
"settings.hint" = "機能名やボタンにポインタを合わせると詳しい説明が表示されます。重複するショートカットは赤色で表示されます。";
"key.helpFormat" = "「%@」に使うキーを選びます。隣の ⌃、⌥、⇧、⌘ を有効にすると、その修飾キーも同時に押す必要があります。";
"modifiers.control" = "Control (⌃)：有効にすると、Control を押しながら選択したキーを押します。";
"modifiers.option" = "Option (⌥)：有効にすると、Option を押しながら選択したキーを押します。";
"modifiers.shift" = "Shift (⇧)：有効にすると、Shift を押しながら選択したキーを押します。";
"modifiers.command" = "Command (⌘)：有効にすると、Command を押しながら選択したキーを押します。";
"conflict.helpFormat" = "%@ は別の機能にも割り当てられています。目的の機能を実行できるよう、キーか修飾キーを変更してください。";
"available.helpFormat" = "%@ はこの一覧の他の機能と重複していません。";
"reset.help" = "この一覧のすべてのショートカットを初期設定に戻します。写真のタグ名と付けたタグは保持されます。";
"action.previousPage.help" = "前の画像に移動します。複数の画像を同時に表示している場合は前のページに移動します。A/B 比較中は A のみ / 両方 / B のみの設定に従い、ロックされた側はそのままにします。";
"action.nextPage.help" = "次の画像に移動します。複数の画像を同時に表示している場合は次のページに移動します。A/B 比較中は A のみ / 両方 / B のみの設定に従い、ロックされた側はそのままにします。";
"action.zoomIn.help" = "画像の表示倍率を上げます。A/B 比較中は拡大同期の設定に応じて、選択中の枠または両方に適用します。";
"action.zoomOut.help" = "画像の表示倍率を下げます。A/B 比較中は拡大同期の設定に応じて、選択中の枠または両方に適用します。";
"action.fitToWindow.help" = "画像全体が表示領域に収まるように調整し、拡大倍率と移動位置をリセットします。";
"action.actualPixels.help" = "元画像を実際のピクセルサイズ（1:1）で表示し、移動位置をリセットします。大きな画像は表示領域からはみ出す場合があります。";
"action.toggleOverview.help" = "画像を大きく表示するビューアと、写真のサムネイル一覧を切り替えます。";
"action.toggleFocus.help" = "ツールバーを隠して画像に集中する表示に切り替えます。もう一度押すか Esc を押すと集中モードを終了します。";
"action.fewerImages.help" = "通常のビューアで同時に表示する画像を1枚減らします。最少1枚まで減らせます。";
"action.moreImages.help" = "通常のビューアで同時に表示する画像を1枚増やします。最大10枚まで表示できます。";
"action.openFolder.help" = "画像、フォルダ、対応する圧縮ファイルを選んで開きます。A/B 比較中は選択中の枠に開きます。";
"action.exportImage.help" = "現在の画像に編集内容を反映して保存します。保存ダイアログでファイル名と保存先を選べます。";
"action.panPrimaryDrag.help" = "画像の移動方法を左ボタンでのドラッグに設定します。その後、拡大した画像を左ボタンでドラッグして移動します。";
"action.panSpaceDrag.help" = "画像の移動方法を Space＋左ボタンでのドラッグに設定します。その後、Space を押しながら拡大した画像を左ボタンでドラッグします。";
"action.panSecondaryDrag.help" = "画像の移動方法を右ボタンでのドラッグに設定します。その後、拡大した画像を右ボタンでドラッグして移動します。";
"action.panMiddleDrag.help" = "画像の移動方法を中央ボタンでのドラッグに設定します。その後、ホイールまたは中央ボタンを押したまま拡大した画像をドラッグします。";
"action.panTrackpadScroll.help" = "画像の移動方法をトラックパッドの2本指スクロールに設定します。その後、拡大中に2本指でスクロールして上下左右に移動します。";
"action.toggleAntialiasing.help" = "拡大時のピクセル境界を滑らかに表示するか、そのまま表示するかを切り替えます。元画像にない細部を生成する機能ではありません。";
"action.compareSideBySide.help" = "同じ画像の滑らかな拡大表示とピクセル境界を保った表示を左右に並べて比較します。異なる写真を開く A/B 比較とは別の機能です。";
"action.compareStacked.help" = "同じ画像の滑らかな拡大表示とピクセル境界を保った表示を上下に並べて比較します。異なる写真を開く A/B 比較とは別の機能です。";
"action.endMagnificationComparison.help" = "同じ画像の拡大方法の比較を終了し、通常の表示に戻ります。A/B の写真比較を終了するショートカットではありません。";
"action.toggleSlideshow.help" = "設定した間隔で写真を自動で切り替えるスライドショーを再生または一時停止します。再生時は集中モードで1枚ずつ表示領域に合わせます。";
"action.setWallpaper.help" = "現在の写真の壁紙設定を開きます。適用先の画面と配置方法を確認してから設定できます。";
"action.toggleFolderComparison.help" = "写真やフォルダを2つの枠に開く A/B 比較に切り替えます。もう一度押すと比較前の表示に戻ります。";
"action.previousFirstFolder.help" = "A/B 比較で A 側だけを前の写真に移動します。ファイル名による対応付け中は、両側が前のペアに移動します。";
"action.nextFirstFolder.help" = "A/B 比較で A 側だけを次の写真に移動します。ファイル名による対応付け中は、両側が次のペアに移動します。";
"action.previousSecondFolder.help" = "A/B 比較で B 側だけを前の写真に移動します。ファイル名による対応付け中は、両側が前のペアに移動します。";
"action.nextSecondFolder.help" = "A/B 比較で B 側だけを次の写真に移動します。ファイル名による対応付け中は、両側が次のペアに移動します。";
